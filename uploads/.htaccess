# Tắt hiển thị danh sách tệp tải lên.
Options -Indexes

# Chỉ chặn tệp thực sự tồn tại.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Chặn thực thi mã nếu tệp tồn tại.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule \.(php[0-9]*|phtml|phar|phps|cgi|pl|py|sh|asp|aspx|jsp|shtml)$ - [F,L,NC]

    # Chặn truy cập tệp ẩn nếu tệp tồn tại.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# Ngăn trình duyệt tự nhận diện và thực thi nội dung tải lên.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>