# api.http - Kiem thu API Cook with me (VS Code: extension "REST Client")
# REST Client tu dong quan ly cookie sau khi dang nhap.
# Chay request dang nhap truoc khi kiem thu cac API can xac thuc.

@host = http://localhost/ltweb-doan-nhom04-main

@email = EMAIL_THAY_THE
@matKhau = MAT_KHAU_THAY_THE


### ĐĂNG NHẬP - BƯỚC 1: Lấy trang đăng nhập và CSRF token
# @name trangDangNhap
GET {{host}}/dang-nhap.php
Accept: text/html

> {%
const match = response.body.match(/name="csrf" value="([^"]+)"/);

if (!match) {
    throw new Error("Không tìm thấy CSRF token trong biểu mẫu đăng nhập.");
}

client.global.set("csrfLogin", match[1]);
%}

### ĐĂNG NHẬP - BƯỚC 2: Kiểm tra phản hồi trang đăng nhập
GET {{host}}/dang-nhap.php
Accept: text/html

###############################################################
# API 1: /api/mon-an.php  (chi cho phep GET, khong can dang nhap)
###############################################################

### 1.1 Danh sach mon an -> 200, co "success": true
GET {{host}}/api/mon-an.php

### 1.2 Tim kiem theo tu khoa -> 200
GET {{host}}/api/mon-an.php?q=bo

### 1.3 Loc theo danh muc -> 200
GET {{host}}/api/mon-an.php?dm=Món chính

### 1.4 Chi tiet 1 mon theo slug -> 200
GET {{host}}/api/mon-an.php?id=cao-lau

### 1.5 Slug khong ton tai -> 404
GET {{host}}/api/mon-an.php?id=mon-khong-ton-tai

### 1.6 Slug sai dinh dang (chua ky tu hoa/dac biet) -> 400
GET {{host}}/api/mon-an.php?id=ABC_@@

### 1.7 Tham so dang mang ?id[]=x -> 400 (khong duoc gay TypeError)
GET {{host}}/api/mon-an.php?id[]=x

### 1.8 Tham so qua dai (q > 200 ky tu) -> 400
GET {{host}}/api/mon-an.php?q=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

### 1.9 Sai phuong thuc (POST) -> 405, header Allow: GET
POST {{host}}/api/mon-an.php
Content-Type: application/json

{}

### 1.10 Sai phuong thuc (DELETE) -> 405
DELETE {{host}}/api/mon-an.php

###############################################################
# API 2: /api/mon-an-yeu-thich.php  (GET, POST; can dang nhap)
###############################################################

### 2.1 Chua dang nhap (khong gui cookie) -> 401
GET {{host}}/api/mon-an-yeu-thich.php

### 2.2 Da dang nhap, xem danh sach yeu thich -> 200
# @name layGio
GET {{host}}/api/mon-an-yeu-thich.php
Accept: application/json

### 2.3 Sai phuong thuc (DELETE) -> 405, header Allow: GET, POST
DELETE {{host}}/api/mon-an-yeu-thich.php

### 2.4 Them mon vao gio -> 200
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "them",
  "id_mon": "cao-lau",
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

### 2.5 Cap nhat so luong hop le -> 200
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "cap_nhat",
  "id_mon": "cao-lau",
  "so_luong": 2,
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

### 2.6 So luong ngoai khoang 1-10 -> 422
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "cap_nhat",
  "id_mon": "cao-lau",
  "so_luong": 99,
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

### 2.7 So luong khong phai so nguyen -> 422
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "cap_nhat",
  "id_mon": "cao-lau",
  "so_luong": "abc",
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

### 2.8 Mon khong ton tai khi them -> 404
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "them",
  "id_mon": "mon-khong-ton-tai",
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

### 2.9 Ma mon sai dinh dang -> 422
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "them",
  "id_mon": "ABC_@@",
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

### 2.10 Hanh dong khong hop le -> 422
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "phap-thuat",
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

### 2.11 Sai CSRF token -> 403
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: token-sai
Content-Type: application/json

{
  "hanh_dong": "xoa_het",
  "csrf_token": "token-sai"
}

### 2.12 Sai Content-Type -> 400
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: text/plain

hanh_dong=xoa_het

### 2.13 JSON hong -> 400
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{ "hanh_dong": "them", 

### 2.14 JSON la mang chu khong phai doi tuong -> 400
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

[1, 2, 3]

### 2.15 Xoa 1 mon -> 200
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "xoa",
  "id_mon": "cao-lau",
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

### 2.16 Xoa het -> 200
POST {{host}}/api/mon-an-yeu-thich.php
X-CSRF-Token: {{layGio.response.body.csrf_token}}
Content-Type: application/json

{
  "hanh_dong": "xoa_het",
  "csrf_token": "{{layGio.response.body.csrf_token}}"
}

###############################################################
# Loi may chu 500 -> {"loi":"Loi may chu"}
# Cach thu: tat MySQL trong XAMPP roi gui lai request 1.1 (mon-an).
# Phai nhan Status 500 va body {"loi":"Lỗi máy chủ"}. Bat MySQL lai sau khi thu.
###############################################################


###############################################################
# API 3: /api/danh-sach-di-cho.php (GET, POST; can dang nhap)
###############################################################

### 3.1 Chua dang nhap -> 401
GET {{host}}/api/danh-sach-di-cho.php

### 3.2 Da dang nhap, lay danh sach di cho -> 200
# @name layDanhSachDiCho
GET {{host}}/api/danh-sach-di-cho.php
Accept: application/json

### 3.3 Khong cho phep DELETE -> 405
DELETE {{host}}/api/danh-sach-di-cho.php
Accept: application/json

### 3.4 Them mon hop le vao danh sach di cho -> 200
# @name themMonDiCho
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "them",
    "id_mon": "ca-kho-to",
    "so_luong": 1,
    "csrf_token": "{{layDanhSachDiCho.response.body.csrf_token}}"
}

### 3.5 So luong vuot gioi han -> 422
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "them",
    "id_mon": "ca-kho-to",
    "so_luong": 11,
    "csrf_token": "{{layDanhSachDiCho.response.body.csrf_token}}"
}

### 3.6 So luong khong phai so -> 422
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "them",
    "id_mon": "ca-kho-to",
    "so_luong": "abc",
    "csrf_token": "{{layDanhSachDiCho.response.body.csrf_token}}"
}

### 3.7 Ma mon khong ton tai -> 422
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "them",
    "id_mon": "mon-an-khong-ton-tai",
    "so_luong": 1,
    "csrf_token": "{{layDanhSachDiCho.response.body.csrf_token}}"
}

### 3.8 Ma mon sai dinh dang -> 422
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "them",
    "id_mon": "ca-kho-to@123",
    "so_luong": 1,
    "csrf_token": "{{layDanhSachDiCho.response.body.csrf_token}}"
}

### 3.9 Hanh dong khong hop le -> 422
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "thanh_toan",
    "id_mon": "ca-kho-to",
    "so_luong": 1,
    "csrf_token": "{{layDanhSachDiCho.response.body.csrf_token}}"
}

### 3.10 CSRF khong hop le -> 403
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: token-sai

{
    "hanh_dong": "them",
    "id_mon": "ca-kho-to",
    "so_luong": 1,
    "csrf_token": "token-sai"
}

### 3.11 Content-Type khong hop le -> 400
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: text/plain
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "them",
    "id_mon": "ca-kho-to",
    "so_luong": 1,
    "csrf_token": "{{layDanhSachDiCho.response.body.csrf_token}}"
}

### 3.12 JSON sai cu phap -> 400
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "them",
    "id_mon":
}

### 3.13 JSON la mang thay vi doi tuong -> 400
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

[
    "them",
    "ca-kho-to",
    1
]

### 3.14 Cap nhat mon khong co trong danh sach -> 404
POST {{host}}/api/danh-sach-di-cho.php
Accept: application/json
Content-Type: application/json
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

{
    "hanh_dong": "cap_nhat",
    "id_mon": "mon-chua-co-trong-danh-sach",
    "so_luong": 2,
    "csrf_token": "{{layDanhSachDiCho.response.body.csrf_token}}"
}

### 4.1 GET dang xuat -> 405
GET {{host}}/dang-xuat.php
Accept: text/html

### 4.2 POST dang xuat khong co CSRF -> 403
POST {{host}}/dang-xuat.php
Accept: text/html
Content-Type: application/x-www-form-urlencoded

### 4.3 POST dang xuat co CSRF hop le -> 302
POST {{host}}/dang-xuat.php
Accept: text/html
Content-Type: application/x-www-form-urlencoded
X-CSRF-Token: {{layDanhSachDiCho.response.body.csrf_token}}

csrf={{layDanhSachDiCho.response.body.csrf_token}}

### KIỂM THỬ CSRF: POST không có token -> 403
POST {{host}}/api/mon-an-yeu-thich.php
Content-Type: application/json
Accept: application/json

{
    "hanh_dong": "xoa_het"
}

### KIỂM THỬ CSRF: POST có token sai -> 403
POST {{host}}/api/mon-an-yeu-thich.php
Content-Type: application/json
Accept: application/json
X-CSRF-Token: token-gia-khong-hop-le

{
    "hanh_dong": "xoa_het",
    "csrf_token": "token-gia-khong-hop-le"
}

### KIỂM THỬ CSRF: Lấy token hợp lệ
# @name layTokenCSRF
GET {{host}}/api/mon-an-yeu-thich.php
Accept: application/json

### KIỂM THỬ CSRF: POST có token hợp lệ
POST {{host}}/api/mon-an-yeu-thich.php
Content-Type: application/json
Accept: application/json
X-CSRF-Token: {{layTokenCSRF.response.body.csrf_token}}

{
    "hanh_dong": "xoa_het",
    "csrf_token": "{{layTokenCSRF.response.body.csrf_token}}"
}

### POST có CSRF hợp lệ, dữ liệu nghiệp vụ không hợp lệ
POST {{host}}/api/mon-an-yeu-thich.php
Content-Type: application/json
Accept: application/json
X-CSRF-Token: {{layTokenCSRF.response.body.csrf_token}}

{
    "hanh_dong": "cap_nhat",
    "id_mon": "kiem_thu_csrf_khong_ton_tai",
    "so_luong": 1,
    "csrf_token": "{{layTokenCSRF.response.body.csrf_token}}"
}

### KIỂM THỬ POST đăng nhập có CSRF hợp lệ
POST {{host}}/dang-nhap.php
Content-Type: application/x-www-form-urlencoded
Accept: text/html
X-CSRF-Token: {{csrfLogin}}

csrf={{csrfLogin}}&email=&mat_khau=
